# Optional: authenticates backend GitHub release lookups to avoid shared-IP rate limits.
# On Render, add this as a secret environment variable. Never commit a real token.
# A fine-grained token should have read-only access to the public frontend repository.
GITHUB_TOKEN=

# Supabase backend credentials. Keep the service-role key server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
